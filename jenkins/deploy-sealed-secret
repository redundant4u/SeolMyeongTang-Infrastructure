pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: kubeseal
      image: your-registry/kubeseal-agent:latest
      command: ["sh", "-c", "sleep infinity"]
"""
        }
    }

    options {
        timeout(time: 10, unit: 'MINUTES')
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'prod'],
            description: 'Deployment Environment'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                container('kubeseal') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        extensions: [
                            [$class: 'CloneOption', depth: 1, shallow: true, noTags: true]
                        ],
                        userRemoteConfigs: [[
                            url: 'https://github.com/redundant4u/SeolMyeongTang-Infrastructure.git',
                            credentialsId: 'smt-github-credential'
                        ]],
                    ])
                }
            }
        }

        stage('Seal Secret') {
          steps {
            container('kubeseal') {
              withCredentials([
                file(credentialsId: 'SEALED_SECRETS_PUB_KEY', variable: 'SEALED_PUB_KEY')
                file(credentialsId: 'PLAIN_SECRET_YAML', variable: 'SECRET_YAML')
              ]) {
                sh """
                    kubeseal \
                        --cert \$SEALED_PUB_KEY \
                        --format yaml \
                        < \$SECRET_YAML \
                        > k8s/overlays/${params.ENVIRONMENT}/sealed-secrets.yaml
                """
              }
            }
          }
        }

        stage('Git Commit & Push') {
            steps {
                container('kubeseal') {
                    sh """
                        git config user.email "smt-jenkins"
                        git config user.name "smt-jenkins@ci"

                        git add k8s/overlays/${params.ENVIRONMENT}/sealed-secrets.yaml
                        git commit -m "ci: update sealed secret"
                        git push origin main
                    """
                }
            }
        }
    }
}


kubeseal \
  --cert sealed-secrets.pub.pem \
  --format yaml < secrets.yaml > sealed-secret.yaml

kubeseal \
    --controller-name sealed-secrets \
    --controller-namespace kube-system \
    --format yaml < secrets.yaml > sealed-secrets.yaml

